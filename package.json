{
  "name": "dsh-media-mcp",
  "version": "0.3.0",
  "description": "Zero-dependency MCP server that generates images, videos and speech through a configurable provider and exposes its own configuration as tools.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "bin": {
    "media-gen": "bin/media-gen.mjs"
  },
  "main": "src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./server": "./src/server.mjs",
    "./cli": "./src/cli.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "README.zh.md",
    "config.example.yml",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "start": "node src/server.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "dsh",
    "deepseek-harness",
    "image-generation",
    "text-to-image",
    "video-generation",
    "text-to-speech",
    "tts"
  ]
}
